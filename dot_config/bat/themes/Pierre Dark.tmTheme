<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key>
  <string>Pierre Dark</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#fafafa</string>
        <key>background</key>
        <string>#0a0a0a</string>
        <key>caret</key>
        <string>#009fff</string>
        <key>invisibles</key>
        <string>#737373</string>
        <key>gutterForeground</key>
        <string>#737373</string>
        <key>gutterForegroundHighlight</key>
        <string>#a3a3a3</string>
        <key>lineHighlight</key>
        <string>#19283c</string>
        <key>selection</key>
        <string>#19283c</string>
        <key>selectionBorder</key>
        <string>#009fff</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Comment</string>
      <key>scope</key>
      <string>comment, punctuation.definition.comment</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#737373</string>
        <key>fontStyle</key>
        <string>italic</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>String</string>
      <key>scope</key>
      <string>string, constant.other.symbol</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#5ecc71</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Number and boolean</string>
      <key>scope</key>
      <string>constant.numeric, constant.language.boolean</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#68cdf2</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Constant</string>
      <key>scope</key>
      <string>constant, variable.other.constant, variable.language</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#ffab16</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Keyword</string>
      <key>scope</key>
      <string>keyword, keyword.control, storage, storage.type, storage.modifier</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#ff678d</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Variable</string>
      <key>scope</key>
      <string>variable, identifier, meta.definition.variable</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#ffa359</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Parameter</string>
      <key>scope</key>
      <string>variable.parameter, function.parameter</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#a3a3a3</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Function</string>
      <key>scope</key>
      <string>support.function, entity.name.function, meta.function-call, variable.function</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#9d6afb</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Type and class</string>
      <key>scope</key>
      <string>support.type, entity.name.type, entity.name.class, support.class</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#d568ea</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Operator</string>
      <key>scope</key>
      <string>keyword.operator, punctuation.separator, punctuation.terminator</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#08c0ef</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Tag</string>
      <key>scope</key>
      <string>entity.name.tag, entity.other.attribute-name</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#009fff</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Markup heading</string>
      <key>scope</key>
      <string>markup.heading, markup.heading.markdown</string>

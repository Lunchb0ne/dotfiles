# My Custom Hosts

Host ssh-scenes.lunchb0ne.me
	HostName ssh-scenes.lunchb0ne.me
	User opc

Host lab
  HostName 192.168.0.176
  User root

# All other hosts
Host *
    IdentityAgent ~/.1password/agent.sock
    ForwardAgent yes
    ServerAliveInterval 60
    ConnectTimeout 10
    AddKeysToAgent yes
    EscapeChar `
    ControlMaster auto
    ControlPersist 72000
    ControlPath ~/.ssh/s/%C

Include ~/.ssh/hostconfig
Include ~/.orbstack/ssh/config
Include ~/.ssh/1Password/config